POSTGRES_DB=stream_mvp
POSTGRES_USER=stream_mvp
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://stream_mvp:replace-with-a-long-random-password@postgres:5432/stream_mvp
REDIS_URL=redis://redis:6379
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=https://replace-with-private-hostname.example
NODE_ENV=production
SESSION_TTL_HOURS=12
LOCAL_DEMO_PASSWORD=replace-with-a-long-synthetic-account-password
TRUST_PROXY=true
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_MULTIPLIER=1
DATABASE_POOL_MAX=20
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
APP_PORT=8080
PRIVATE_SSH_TUNNEL=false
CLOUDFLARE_STREAM_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-rotated-production-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace-with-customer-code
CLOUDFLARE_STREAM_LIVE_INPUT_ID=replace-with-live-input-id
