# Copy to .env for local development. Never commit the real token.
POSTGRES_DB=stream_mvp
POSTGRES_USER=stream_mvp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://stream_mvp:change-me@localhost:5432/stream_mvp
REDIS_URL=redis://localhost:6379
API_PORT=3001
API_HOST=127.0.0.1
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
LOCAL_DEMO_PASSWORD=replace-with-a-long-local-demo-password
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_MULTIPLIER=1
DATABASE_POOL_MAX=20
METRICS_TOKEN=local-metrics-token-not-for-production

# Cloudflare Stream (server-side only)
CLOUDFLARE_STREAM_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-token
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace-with-customer-code
CLOUDFLARE_STREAM_LIVE_INPUT_ID=replace-with-live-input-id
