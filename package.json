{
  "name": "stream-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev --workspace=@stream-mvp/api\" \"npm run dev --workspace=@stream-mvp/web\"",
    "check": "npm run check --workspaces --if-present",
    "test": "node --env-file=.env --import tsx --test apps/api/tests/schema.test.ts apps/api/tests/broadcast-status.test.ts apps/api/tests/broadcast-poller.test.ts apps/api/tests/cloudflare-webrtc.test.ts apps/api/tests/browser-webrtc-client.test.ts",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx apps/api/src/db/seed.ts",
    "verify:local": "node --env-file=.env --import tsx scripts/verify-local.ts",
    "verify:realtime": "node --env-file=.env scripts/verify-realtime.mjs",
    "verify:realtime:cluster": "node --env-file=.env scripts/verify-realtime-cluster.mjs",
    "verify:auth": "node --env-file=.env scripts/verify-auth.mjs",
    "verify:registration": "node --env-file=.env scripts/verify-registration.mjs",
    "verify:account-lifecycle": "node --env-file=.env scripts/verify-account-lifecycle.mjs",
    "verify:creator-applications": "node --env-file=.env --import tsx scripts/verify-creator-applications.mjs",
    "verify:audience-retention": "node --env-file=.env scripts/verify-audience-retention.mjs",
    "verify:gift-polish": "node --env-file=.env scripts/verify-gift-polish.mjs",
    "verify:policy-plans": "node scripts/verify-policy-plans.mjs",
    "verify:commercial-design": "node scripts/verify-commercial-design.mjs",
    "verify:six-phase-audit": "node scripts/verify-six-phase-audit.mjs",
    "verify:test-only-goal": "node scripts/verify-test-only-goal.mjs",
    "verify:frontend-foundation": "node scripts/verify-frontend-foundation.mjs",
    "verify:desktop-discovery": "node scripts/verify-desktop-discovery.mjs",
    "verify:desktop-room": "node scripts/verify-desktop-room.mjs",
    "verify:mobile-shell": "node scripts/verify-mobile-shell.mjs",
    "verify:mobile-discovery": "node scripts/verify-mobile-discovery.mjs",
    "verify:mobile-room": "node scripts/verify-mobile-room.mjs",
    "verify:mobile-broadcast": "node scripts/verify-mobile-broadcast.mjs",
    "verify:broadcaster-ui": "node scripts/verify-broadcaster-ui.mjs",
    "verify:creator-profile-ui": "node scripts/verify-creator-profile-ui.mjs",
    "verify:frontend-polish": "node scripts/verify-frontend-polish.mjs",
    "verify:web-bundle-budget": "npm run build --workspace=@stream-mvp/web && node scripts/verify-web-bundle-budget.mjs",
    "verify:security": "node --env-file=.env scripts/verify-security.mjs",
    "verify:resilience": "node --env-file=.env scripts/verify-resilience.mjs",
    "verify:logs": "node --env-file=.env scripts/verify-log-redaction.mjs",
    "verify:external-gates": "node scripts/verify-external-gates.mjs",
    "verify:backup-restore": "node --env-file=.env scripts/verify-backup-restore.mjs",
    "verify:production-compose": "node scripts/verify-production-compose.mjs",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "verify:production-env-validator": "node scripts/verify-production-env-validator.mjs",
    "verify:staging-operator": "node scripts/verify-private-staging-operator.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify:supply-chain:online": "npm audit --omit=dev --audit-level=high",
    "verify:image-lock": "node scripts/verify-image-lock.mjs",
    "verify:release-preflight": "node scripts/verify-release-preflight.mjs",
    "verify:load:100": "node --env-file=.env scripts/verify-load-100.mjs",
    "verify:load:production:100": "node scripts/verify-load-production-100.mjs",
    "build": "npm run build --workspaces --if-present",
    "verify:lifecycle": "node --env-file=.env scripts/verify-lifecycle.mjs",
    "verify:cloudflare": "node --env-file=.env scripts/verify-cloudflare.mjs",
    "verify:cloudflare-live": "node --env-file=.env scripts/verify-cloudflare-live.mjs",
    "verify:camera-live": "node --env-file=.env scripts/verify-camera-cloudflare.mjs",
    "verify:expanded": "npm run db:seed && node --env-file=.env scripts/verify-expanded.mjs && npm run db:seed",
    "verify:staging": "npm run db:migrate && npm run db:seed && npm run check && npm test && npm run verify:image-lock && npm run verify:production-env-validator && npm run verify:staging-operator && npm run verify:supply-chain && npm run verify:test-only-goal && npm run verify:frontend-foundation && npm run verify:desktop-discovery && npm run verify:desktop-room && npm run verify:mobile-shell && npm run verify:mobile-discovery && npm run verify:mobile-room && npm run verify:mobile-broadcast && npm run verify:broadcaster-ui && npm run verify:creator-profile-ui && npm run verify:frontend-polish && npm run verify:web-bundle-budget && npm run verify:local && npm run verify:security && npm run verify:logs && npm run verify:external-gates && npm run verify:auth && npm run verify:registration && npm run verify:account-lifecycle && npm run verify:creator-applications && npm run db:seed && npm run verify:audience-retention && npm run db:seed && npm run verify:gift-polish && npm run db:seed && npm run verify:realtime && npm run verify:realtime:cluster && npm run verify:lifecycle && npm run verify:expanded"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
